# PostgreSQL (Neon / Supabase / local Docker). Vercel: Project → Settings → Environment Variables.
# Use a pooled URL if your host provides one (e.g. Neon "Pooled connection").
# Neon (recommended): use the *pooled* connection string from Neon dashboard
# Host looks like: ep-xxxx-pooler.us-east-2.aws.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Optional for prisma migrate (Neon direct / non-pooler URL)
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# One-time live seed (Vercel env) — POST /api/setup/seed with header x-setup-secret
SETUP_SECRET="choose-a-long-random-string"

# Public: shown next to prices in the storefront and admin UI.
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."

# Copy to `.env` or `.env.local` for local development (those files are gitignored).

# Brand Social Media & Contact Links
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/merryberry.pk?igsh=MXZqZWNqcmdwbHFsOQ=="
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/share/1abt67TZu4/"
NEXT_PUBLIC_CONTACT_EMAIL="merryberrytshirts@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE="+92 300 0000000"

# Payment instructions shown on checkout for manual bank transfer / digital wallet workflows
NEXT_PUBLIC_BANK_NAME="Meezan / HBL"
NEXT_PUBLIC_BANK_ACCOUNT_TITLE="Merry Berry Pakistan"
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="0000-0000000000"
NEXT_PUBLIC_WALLET_TITLE="Merry Berry Pakistan"
NEXT_PUBLIC_WALLET_NUMBER="+92 300 0000000"
